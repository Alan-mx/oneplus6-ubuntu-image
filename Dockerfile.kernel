FROM ubuntu@sha256:0e73b71479e7bc5f006bca872e25c3cd680dc052a0116f90d63ae363537db0dd

ENV DEBIAN_FRONTEND=noninteractive

RUN sed -i \
        -e 's|http://archive.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' \
        -e 's|http://security.ubuntu.com/ubuntu|http://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' \
        /etc/apt/sources.list.d/ubuntu.sources

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bc=1.07.1-4build1 \
        bison=2:3.8.2+dfsg-1ubuntu0.26.04.1 \
        ca-certificates=20260816ubuntu0.26.04.1 \
        clang=1:21.1.6-71 \
        cpio=2.15+dfsg-2.1ubuntu0.1 \
        curl=8.18.0-1ubuntu2.8 \
        device-tree-compiler=1.7.2-2ubuntu1 \
        flex=2.6.4-8.2build2 \
        gcc-aarch64-linux-gnu=4:15.2.0-5ubuntu1 \
        git=1:2.53.0-1ubuntu1.1 \
        kmod=34.2-2ubuntu2 \
        libelf-dev=0.194-4 \
        libssl-dev=3.5.5-1ubuntu3.7 \
        lld=1:21.1.6-71 \
        llvm=1:21.1.6-71 \
        make=4.4.1-3 \
        pahole=1.31-2ubuntu1 \
        patch=2.8-2build1 \
        perl=5.40.1-7ubuntu0.3 \
        python3=3.14.3-0ubuntu2 \
        python3-setuptools=78.1.1-0.1build1 \
        rsync=3.4.1+ds1-7ubuntu0.3 \
        xz-utils=5.8.3-1ubuntu0.1 \
        zstd=1.5.7+dfsg-3 \
    && rm -rf /var/lib/apt/lists/*

COPY config/kernel-builder-packages.lock.tsv /tmp/kernel-builder-packages.lock.tsv
RUN dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\n' \
        | LC_ALL=C sort > /tmp/kernel-builder-packages.actual.tsv \
    && cmp /tmp/kernel-builder-packages.lock.tsv /tmp/kernel-builder-packages.actual.tsv \
    && rm -f /tmp/kernel-builder-packages.lock.tsv /tmp/kernel-builder-packages.actual.tsv

WORKDIR /work
