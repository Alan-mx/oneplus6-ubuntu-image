FROM ubuntu@sha256:0e73b71479e7bc5f006bca872e25c3cd680dc052a0116f90d63ae363537db0dd

ENV DEBIAN_FRONTEND=noninteractive

ARG UBUNTU_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
ARG UBUNTU_PORTS_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports

RUN set -eu; \
    for attempt in 1 2 3 4 5; do \
        apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=60 update && break; \
        [ "$attempt" -lt 5 ] || exit 1; sleep 3; \
    done; \
    for attempt in 1 2 3 4 5; do \
        apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=60 install -y --no-install-recommends \
            ca-certificates=20260816ubuntu0.26.04.1 && break; \
        [ "$attempt" -lt 5 ] || exit 1; sleep 3; \
    done; \
    rm -rf /var/lib/apt/lists/*

RUN sed -i \
        -e "s|http://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
        -e "s|http://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
        /etc/apt/sources.list.d/ubuntu.sources

RUN dpkg --add-architecture arm64 \
    && sed -i 's/^Types: deb$/Types: deb\nArchitectures: amd64/' /etc/apt/sources.list.d/ubuntu.sources \
    && printf 'Types: deb\nURIs: %s\nSuites: resolute resolute-updates resolute-security\nComponents: main universe\nArchitectures: arm64\nSigned-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg\n' "$UBUNTU_PORTS_MIRROR" > /etc/apt/sources.list.d/arm64.sources \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=60 update \
    && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=60 install -y --no-install-recommends \
        bc=1.07.1-4build1 \
        bison=2:3.8.2+dfsg-1ubuntu0.26.04.1 \
        clang=1:21.1.6-71 \
        cpio=2.15+dfsg-2.1ubuntu0.1 \
        curl=8.18.0-1ubuntu2.8 \
        device-tree-compiler=1.7.2-2ubuntu1 \
        flex=2.6.4-8.2build2 \
        gcc-aarch64-linux-gnu=4:15.2.0-5ubuntu1 \
        git=1:2.53.0-1ubuntu1.1 \
        kmod=34.2-2ubuntu2 \
        libelf-dev=0.194-4 \
        libc6-dev-arm64-cross=2.43-2ubuntu2cross1 \
        libssl-dev=3.5.5-1ubuntu3.7 \
        lld=1:21.1.6-71 \
        llvm=1:21.1.6-71 \
        make=4.4.1-3 \
        meson=1.10.1-1ubuntu2 \
        ninja-build=1.13.2-1 \
        pkg-config=2.5.1-4 \
        liblzma-dev:arm64=5.8.3-1ubuntu0.1 \
        libzstd-dev:arm64=1.5.7+dfsg-3 \
        libudev-dev:arm64=259.9-0ubuntu0.1 \
        pahole=1.31-2ubuntu1 \
        patch=2.8-2build1 \
        perl=5.40.1-7ubuntu0.3 \
        linux-libc-dev-arm64-cross=7.0.0-13.13cross1 \
        python3=3.14.3-0ubuntu2 \
        python3-setuptools=78.1.1-0.1build1 \
        rsync=3.4.1+ds1-7ubuntu0.3 \
        xz-utils=5.8.3-1ubuntu0.1 \
        zstd=1.5.7+dfsg-3 \
    && rm -rf /var/lib/apt/lists/*

ARG EXPORT_PACKAGE_LOCK=0
COPY config/kernel-builder-packages.lock.tsv /tmp/kernel-builder-packages.lock.tsv
RUN dpkg-query -W -f='${Package}\t${Version}\t${Architecture}\n' \
        | LC_ALL=C sort > /tmp/kernel-builder-packages.actual.tsv \
    && (test "$EXPORT_PACKAGE_LOCK" = 1 || cmp /tmp/kernel-builder-packages.lock.tsv /tmp/kernel-builder-packages.actual.tsv)

WORKDIR /work
