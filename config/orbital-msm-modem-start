#!/bin/sh
set -eu

state=/sys/class/remoteproc/remoteproc3/state
count=0
while [ ! -e "$state" ]; do
    [ "$count" -ge 300 ] && exit 1
    count=$((count + 1))
    sleep 0.1
done

case "$(cat "$state")" in
    running)
        exit 0
        ;;
    offline)
        echo start > "$state"
        ;;
esac

count=0
while [ "$(cat "$state")" != "running" ]; do
    [ "$count" -ge 300 ] && exit 1
    count=$((count + 1))
    sleep 0.1
done
