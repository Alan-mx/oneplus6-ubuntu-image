[Unit]
Description=Qualcomm Protection Domain mapper service
After=local-fs.target systemd-udev-trigger.service
Before=orbital-msm-modem.service
ConditionPathExists=/usr/bin/pd-mapper

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/orbital-remoteproc-wait
ExecStart=/usr/bin/pd-mapper
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
