#!/bin/sh
set -eu

MARKER_FILE="${MARKER_FILE:-/var/lib/orbital/default-password-pending}"
SHADOW_FILE="${SHADOW_FILE:-/etc/shadow}"
PASSWORD_USER="${PASSWORD_USER:-orbital}"

[ -e "$MARKER_FILE" ] || exit 0

IFS= read -r expected < "$MARKER_FILE" || true
if ! printf '%s\n' "$expected" |
    grep -Eq '^sha256:[0-9a-f]{64}$'; then
    echo "invalid default-password marker format" >&2
    exit 1
fi

password_hash="$(
    awk -F: -v user="$PASSWORD_USER" '
        $1 == user {
            print $2
            found = 1
        }
        END {
            exit !found
        }
    ' "$SHADOW_FILE"
)"
if [ -z "$password_hash" ]; then
    echo "password user not found in shadow database" >&2
    exit 1
fi

actual="sha256:$(printf '%s' "$password_hash" | sha256sum | awk '{print $1}')"
if [ "$actual" != "$expected" ]; then
    rm -f -- "$MARKER_FILE"
    echo "default password marker cleared after password change"
fi
