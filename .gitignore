# Generated build and release artifacts
/out/
/releases/
/work/
/state/
/logs/

# Download caches and local-only inputs; checked-in quick-build inputs are
# explicitly re-included below.
/inputs/*
!/inputs/boot/
!/inputs/boot/README.md
!/inputs/tqftpserv/
!/inputs/tqftpserv/README.md
!/inputs/tqftpserv/tqftpserv
!/inputs/pd-mapper/
!/inputs/pd-mapper/README.md
!/inputs/pd-mapper/pd-mapper
!/inputs/rmtfs/
!/inputs/rmtfs/README.md
!/inputs/rmtfs/rmtfs

# Nested working copy placeholder
/oneplus6-image/

# Images, archives and generated checksum sidecars
*.raw
*.img
!/inputs/boot/oneplus6-boot-gpu-fix.img
*.zip
*.sha256

# Accidental output created by an old tool invocation
/-

# Python and editor caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
